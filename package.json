{
  "name": "soulforge-knight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "node scripts/build-single.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-assets.mjs",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-firebase/analytics": "^8.3.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^13.2.1",
    "@supabase/supabase-js": "^2.110.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^26.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.0"
  }
}
